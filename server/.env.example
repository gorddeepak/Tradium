# Copy this file to .env and fill in real values.
# The server will not start without MONGO_URL.

# MongoDB connection string (required)
MONGO_URL=mongodb://localhost:27017/tradium

# Port the API listens on (optional, defaults to 3002)
PORT=3002

# Secret used to sign auth JWTs (required) — use a long random string
JWT_SECRET=replace-with-a-long-random-string

# Google AI Studio key for Gemini (required for the assistant and insights).
# Read automatically by @ai-sdk/google. Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-key-here
